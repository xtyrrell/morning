{%- style -%}
  .contact-text {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40vh;
    padding: 4rem 2rem;
    text-align: center;
  }

  .contact-text p {
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1.6;
    max-width: 40rem;
    margin: 0 auto;
  }

  .contact-text a {
    color: rgb(var(--color-foreground));
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
{%- endstyle -%}

<div class="contact-text">
  <p>For inquiries and commission information, please email us at <a href="mailto:studio@jadepaton.com">studio@jadepaton.com</a>.</p>
</div>

{% schema %}
{
  "name": "Contact text",
  "tag": "section",
  "class": "section"
}
{% endschema %}
