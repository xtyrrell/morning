<style type="text/css">
  .template-404 .title + * {
    margin-top: 1rem;
  }

  @media screen and (min-width: 750px) {
    .template-404 .title + * {
      margin-top: 2rem;
    }
  }

  .template-404 .about-404-steps {
    text-align: left;
    max-width: 36rem;
    margin: 2rem auto;
    padding: 1.5rem 2rem;
    background: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: var(--media-radius);
  }

  .template-404 .about-404-steps ol {
    margin: 0 0 0 1.25rem;
    padding: 0;
  }

  .template-404 .about-404-steps li {
    margin-bottom: 0.5rem;
  }
</style>

{%- liquid
  assign newsletter_missing_page = false
  if request.path contains '/pages/'
    assign path_parts = request.path | split: '/'
    for part in path_parts reversed
      if part != blank
        if part == 'mailing-list' or part == 'newsletter'
          assign newsletter_missing_page = true
        endif
        break
      endif
    endfor
  endif
-%}

<div class="template-404 page-width page-margin center">
  {%- if request.path == '/pages/about' or request.path == '/pages/about/' -%}
    <h1 class="title">About page not found</h1>
    <p>This page doesn’t exist yet. Create it in your Shopify admin:</p>
    <div class="about-404-steps">
      <ol>
        <li>Go to <strong>Online Store → Pages</strong> (or <strong>Content → Pages</strong>).</li>
        <li>Click <strong>Add page</strong>.</li>
        <li>Set the <strong>Title</strong> to <strong>About</strong>.</li>
        <li>In <strong>Search engine listing</strong>, set the URL handle to <strong>about</strong> so the link is <code>/pages/about</code>.</li>
        <li>Add your content and choose the <strong>About</strong> theme template if you want the split layout.</li>
        <li>Click <strong>Save</strong> and make sure the page is <strong>Published</strong>.</li>
      </ol>
    </div>
    <a href="{{ routes.root_url }}" class="button">Back to home</a>
  {%- elsif newsletter_missing_page -%}
    {{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
    {{ 'newsletter-section.css' | asset_url | stylesheet_tag }}
    <div class="newsletter center newsletter--narrow page-width template-404-newsletter">
      <div class="newsletter__wrapper color-scheme-1 gradient content-container isolate section-padding-404-newsletter">
        <h1 class="h1">Subscribe to mailing list</h1>
        {% render 'newsletter-signup-form', suffix: '404' %}
      </div>
    </div>
    <style>
      .section-padding-404-newsletter {
        padding-top: 2rem;
        padding-bottom: 4rem;
      }
      @media screen and (min-width: 750px) {
        .section-padding-404-newsletter {
          padding-top: 3rem;
          padding-bottom: 6rem;
        }
      }
    </style>
  {%- else -%}
    <p>
      {{ 'templates.404.subtext' | t }}
    </p>
    <h1 class="title">
      {{ 'templates.404.title' | t }}
    </h1>
    <a href="{{ routes.all_products_collection_url }}" class="button">
      {{ 'general.continue_shopping' | t }}
    </a>
  {%- endif -%}
</div>
