{{ 'section-about-split.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 0;
    padding-bottom: 0;
  }
{%- endstyle -%}

<div id="about" class="about-split section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <div class="about-split__grid">
    <div class="about-split__media-wrapper">
      <div class="about-split__media-slider">
        <div class="about-split__media-list" id="AboutSplitMediaList-{{ section.id }}">
          <div class="about-split__media-item">
            <img
              src="{{ '_DSC6264-1.jpg' | asset_url }}"
              alt="{{ page.title | default: section.settings.heading | default: 'About' | escape }}"
              loading="eager"
              width="1200"
              height="800"
            >
          </div>
          <div class="about-split__media-item">
            <img
              src="{{ 'IMG_8262.jpg' | asset_url }}"
              alt="{{ page.title | default: 'About' | escape }}"
              loading="eager"
              width="1200"
              height="800"
            >
          </div>
          <div class="about-split__media-item">
            <img
              src="{{ 'IMG_8203-copy.jpg' | asset_url }}"
              alt="{{ page.title | default: 'About' | escape }}"
              loading="lazy"
              width="1200"
              height="800"
            >
          </div>
        </div>
      </div>
      <div
        class="about-gallery-progress"
        id="about-gallery-progress-{{ section.id }}"
        aria-hidden="true"
        hidden
      >
        <div class="about-gallery-progress__track">
          <div
            class="about-gallery-progress__fill"
            id="about-gallery-progress-fill-{{ section.id }}"
          ></div>
        </div>
      </div>
    </div>
    <div class="about-split__content-wrapper">
      <div class="about-split__content">
        <h1 class="about-split__title h0">
          {{ page.title | default: section.settings.heading | escape }}
        </h1>
        <div class="about-split__text rte">
          {{ page.content | default: section.settings.text }}
        </div>
      </div>
    </div>
  </div>
</div>

<div class="about-split__fullscreen" id="about-split-fullscreen-{{ section.id }}" role="button" tabindex="-1" aria-label="Close">
  <button type="button" class="about-split__fullscreen-back" id="about-split-fullscreen-back-{{ section.id }}" aria-label="Back">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 12H5M12 19l-7-7 7-7"/>
    </svg>
  </button>
  <div class="about-split__fullscreen-dots" id="about-split-fullscreen-dots-{{ section.id }}" aria-hidden="true">
    <!-- Filled by JS: one dot per image -->
  </div>
  <div class="about-split__fullscreen-scroll" id="about-split-fullscreen-scroll-{{ section.id }}">
    <!-- Filled by JS from about section images -->
  </div>
</div>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var fullscreen = document.getElementById('about-split-fullscreen-' + sectionId);
    var scrollEl = document.getElementById('about-split-fullscreen-scroll-' + sectionId);
    var container = document.getElementById('about');
    if (!fullscreen || !scrollEl || !container) return;

    var mediaWrapper = container.querySelector('.about-split__media-wrapper');
    var contentWrapper = container.querySelector('.about-split__content-wrapper');
    var mediaList = document.getElementById('AboutSplitMediaList-' + sectionId);
    var mediaItems = Array.from(container.querySelectorAll('.about-split__media-item'));
    var images = container.querySelectorAll('.about-split__media-item img');
    var progressWrap = document.getElementById('about-gallery-progress-' + sectionId);
    var progressFill = document.getElementById('about-gallery-progress-fill-' + sectionId);
    var imageList = [];

    Array.prototype.forEach.call(images, function(img) {
      var mediaItem = img.closest('.about-split__media-item');
      if (!mediaItem) return;

      var slide = document.createElement('div');
      slide.className = 'about-split__fullscreen-item';
      var clone = document.createElement('img');
      clone.src = img.currentSrc || img.getAttribute('src');
      if (img.srcset) clone.srcset = img.srcset;
      if (img.sizes) clone.sizes = img.sizes;
      clone.alt = img.alt || '';
      slide.appendChild(clone);
      scrollEl.appendChild(slide);
      imageList.push({ mediaItem: mediaItem, img: img });
    });

    /* ——— Desktop (≥750px): same as product — scroll images in left column, wheel on text scrolls images, right-edge rail ——— */
    function setupDesktopGallery() {
      if (window.matchMedia('(max-width: 749px)').matches) return;
      if (!mediaWrapper || !contentWrapper || !mediaItems.length) return;

      var onWheel = function(event) {
        var deltaY = event.deltaY;
        var atTop = mediaWrapper.scrollTop <= 0;
        var atBottom =
          Math.ceil(mediaWrapper.scrollTop + mediaWrapper.clientHeight) >= mediaWrapper.scrollHeight;
        if ((deltaY > 0 && !atBottom) || (deltaY < 0 && !atTop)) {
          event.preventDefault();
          mediaWrapper.scrollTop += deltaY;
        }
      };
      contentWrapper.addEventListener('wheel', onWheel, { passive: false });

      if (progressWrap && progressFill && mediaItems.length > 1) {
        progressWrap.removeAttribute('hidden');
      }

      var syncRailPosition = function() {
        if (!progressWrap || progressWrap.hasAttribute('hidden')) return;
        var r = mediaWrapper.getBoundingClientRect();
        progressWrap.style.position = 'fixed';
        var railW = 2;
        progressWrap.style.left = r.right - railW + 'px';
        progressWrap.style.top = r.top + 'px';
        progressWrap.style.width = railW + 'px';
        progressWrap.style.height = r.height + 'px';
      };

      var updateDesktopProgress = function() {
        if (!progressFill) return;
        var el = mediaWrapper;
        var viewH = el.clientHeight;
        var scrollH = el.scrollHeight;
        var maxScroll = scrollH - viewH;
        progressFill.style.width = '100%';
        progressFill.style.left = '0';
        var trackH = viewH;
        if (maxScroll <= 0 || trackH <= 0) {
          progressFill.style.height = Math.max(0, trackH) + 'px';
          progressFill.style.top = '0';
          return;
        }
        var thumbH = (viewH / scrollH) * trackH;
        thumbH = Math.max(6, Math.min(thumbH, trackH));
        var travel = trackH - thumbH;
        var t = el.scrollTop / maxScroll;
        t = Math.max(0, Math.min(1, t));
        progressFill.style.height = thumbH + 'px';
        progressFill.style.top = t * travel + 'px';
      };

      var onLayoutScroll = function() {
        syncRailPosition();
        updateDesktopProgress();
      };

      mediaWrapper.addEventListener('scroll', onLayoutScroll, { passive: true });
      window.addEventListener('resize', onLayoutScroll);
      window.addEventListener('scroll', onLayoutScroll, { passive: true });
      onLayoutScroll();
    }

    /* ——— Mobile: horizontal strip + thin progress under gallery (product-style) ——— */
    function setupMobileGallery() {
      if (window.matchMedia('(min-width: 750px)').matches) return;
      if (!mediaList || !progressWrap || !progressFill) return;
      if (mediaItems.length <= 1) return;

      progressWrap.removeAttribute('hidden');

      function updateProgressBar() {
        var el = mediaList;
        var maxScroll = el.scrollWidth - el.clientWidth;
        progressFill.style.top = '0';
        progressFill.style.height = '2px';
        if (maxScroll <= 0) {
          progressFill.style.width = '100%';
          progressFill.style.left = '0';
          return;
        }
        var thumbPct = (el.clientWidth / el.scrollWidth) * 100;
        thumbPct = Math.max(6, Math.min(thumbPct, 100));
        var travelPct = 100 - thumbPct;
        var t = el.scrollLeft / maxScroll;
        t = Math.max(0, Math.min(1, t));
        progressFill.style.width = thumbPct + '%';
        progressFill.style.left = t * travelPct + '%';
      }

      var scrollRaf;
      mediaList.addEventListener(
        'scroll',
        function() {
          if (scrollRaf) window.cancelAnimationFrame(scrollRaf);
          scrollRaf = window.requestAnimationFrame(updateProgressBar);
        },
        { passive: true }
      );
      window.addEventListener('resize', updateProgressBar);
      updateProgressBar();
    }

    if (window.matchMedia('(min-width: 750px)').matches) {
      setupDesktopGallery();
    } else {
      setupMobileGallery();
    }

    /* Fullscreen dots + vertical snap scroll */
    var dotsEl = document.getElementById('about-split-fullscreen-dots-' + sectionId);
    if (dotsEl && imageList.length > 1) {
      var dotsFragment = document.createDocumentFragment();
      for (var i = 0; i < imageList.length; i++) {
        var dot = document.createElement('span');
        if (i === 0) dot.classList.add('active');
        dot.setAttribute('role', 'button');
        dot.setAttribute('aria-label', 'Go to image ' + (i + 1));
        dot.dataset.index = i;
        dotsFragment.appendChild(dot);
      }
      dotsEl.appendChild(dotsFragment);
      dotsEl.querySelectorAll('span').forEach(function(dot) {
        dot.addEventListener('click', function(e) {
          e.stopPropagation();
          var idx = parseInt(dot.dataset.index, 10);
          scrollToSlide(idx);
          updateDots(idx);
        });
      });
    }

    function updateDots(activeIndex) {
      if (!dotsEl) return;
      dotsEl.querySelectorAll('span').forEach(function(dot, i) {
        dot.classList.toggle('active', i === activeIndex);
      });
    }

    function scrollToSlide(index) {
      index = Math.max(0, Math.min(index, imageList.length - 1));
      var top = index * scrollEl.clientHeight;
      scrollEl.scrollTo({ top: top, behavior: 'smooth' });
      updateDots(index);
    }

    function getCurrentSlideIndex() {
      var scrollTop = scrollEl.scrollTop;
      var index = Math.round(scrollTop / scrollEl.clientHeight);
      return Math.min(index, imageList.length - 1);
    }

    var isMobile = function() {
      return window.innerWidth < 750;
    };

    imageList.forEach(function(entry, index) {
      function openAtSlide(e) {
        e.preventDefault();
        e.stopPropagation();
        fullscreen.classList.add('is-open');
        document.body.classList.add('about-split-fullscreen-open');
        document.body.style.overflow = 'hidden';
        if (progressWrap) progressWrap.style.visibility = 'hidden';
        scrollToSlide(index);
        updateDots(index);
      }

      entry.img.addEventListener('click', function(e) {
        if (!isMobile()) openAtSlide(e);
      });

      var touchMoved = false;
      entry.mediaItem.addEventListener('touchstart', function() {
        touchMoved = false;
      }, { passive: true });
      entry.mediaItem.addEventListener('touchmove', function() {
        touchMoved = true;
      }, { passive: true });
      entry.mediaItem.addEventListener('touchend', function(e) {
        if (!touchMoved && isMobile()) {
          openAtSlide(e);
        }
      });
    });

    scrollEl.addEventListener('scroll', function() {
      if (!fullscreen.classList.contains('is-open')) return;
      updateDots(getCurrentSlideIndex());
    });

    function closeFullscreen() {
      fullscreen.classList.remove('is-open');
      document.body.classList.remove('about-split-fullscreen-open');
      document.body.style.overflow = '';
      if (progressWrap) progressWrap.style.visibility = '';
    }

    fullscreen.addEventListener('click', function(e) {
      if (e.target === fullscreen) closeFullscreen();
    });
    var backBtn = document.getElementById('about-split-fullscreen-back-' + sectionId);
    if (backBtn)
      backBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        closeFullscreen();
      });
    scrollEl.addEventListener('click', function(e) {
      e.stopPropagation();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && fullscreen.classList.contains('is-open')) closeFullscreen();
    });
  })();
</script>

{% schema %}
{
  "name": "About (split)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (left side)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (fallback if no page title)"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text (fallback if no page content)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "About (split)",
      "settings": {
        "image": "shopify://shop_images/B016522B-D335-43BF-8F22-5CC986817E2A.jpg",
        "heading": "About",
        "color_scheme": "scheme-1"
      }
    }
  ]
}
{% endschema %}
